#!/bin/bash
set -e
cd ~/Sub-C2 || { echo "ERROR: ~/Sub-C2 not found"; exit 1; }

echo "[*] Applying agent debug logging patch..."
echo "" | base64 -d | git apply -v

echo ""
echo "[+] Patch applied! Now rebuild the agent:"
echo "    cargo build --release --target x86_64-pc-windows-gnu -p oxide-agent"
echo ""
echo "[+] After running agent.exe on Windows, check the debug log at:"
echo "    %TEMP%\\oxide_debug.txt"
echo "    (usually C:\\Users\\<you>\\AppData\\Local\\Temp\\oxide_debug.txt)"
